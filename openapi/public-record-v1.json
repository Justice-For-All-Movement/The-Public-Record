{
  "openapi": "3.1.0",
  "info": {
    "title": "The Public Record \u2014 API contract baseline",
    "version": "0.1.0",
    "description": "Schemas for planned domain contracts. Only /api/health is currently implemented; other endpoints are not advertised as live."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Report scaffold state without claiming readiness",
        "operationId": "getScaffoldHealth",
        "responses": {
          "200": {
            "description": "Service exists; production_ready remains false until production gates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Readiness of configured dependencies (no secrets)",
        "responses": {
          "200": {
            "description": "OK"
          },
          "503": {
            "description": "See summary"
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "summary": "Start sign-in (authorization code + PKCE); 303 to the identity provider",
        "responses": {
          "303": {
            "description": "See summary"
          },
          "503": {
            "description": "See summary"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "summary": "Complete sign-in; sets the session cookie; 303 to a same-site path",
        "responses": {
          "303": {
            "description": "See summary"
          }
        }
      }
    },
    "/api/auth/logout": {
