# Store actual credentials in provider secrets; do not commit them.
# Every variable is optional: with none set, the app serves the public preview.

# Deployment stage: local | test | preview | staging | production
# TPR_ENVIRONMENT=local

# PostgreSQL (Neon in hosted environments). Enables member drafts/lifecycle.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional separate owner/direct connection used only for migrations.
# MIGRATION_DATABASE_URL=
# NOLOGIN NOBYPASSRLS role from migration 0003, assumed per private transaction.
# DATABASE_RUNTIME_ROLE=tpr_app_runtime
# TPR_MIGRATE_ON_START=true
# Local/test only: allow a superuser/BYPASSRLS DB role for private routes.
# TPR_ALLOW_PRIVILEGED_DB_ROLE=false

# Sign-in: disabled | fake (synthetic identities, never production) | oidc
# AUTH_PROVIDER=disabled
# base64url, >= 32 random bytes: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# SESSION_SECRET=

# Justice For All OIDC (AUTH_PROVIDER=oidc); endpoints must share the issuer origin.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://YOUR-HOST/api/auth/callback
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_JWKS_URI=

# FOIA Aggregator read-only public archive resolver.
# FOIA_AGGREGATOR_PUBLIC_URL=
# FOIA_AGGREGATOR_FIXTURES=true
